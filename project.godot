; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Ultimate Cakum Pakum"
config/version="1.0.0"
config/icon="res://assets/icon.png"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

BlockRegistry="*res://blocks/BlockRegistry.gd"
SignalBus="*res://scripts/core/signal_bus.gd"
PlayerManager="*res://scripts/core/player_manager.gd"
MatchManager="*res://scripts/core/match_manager.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/mode=3

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

